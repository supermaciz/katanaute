<div class="mx-auto max-w-sm">
  <div class="text-center">
    <.header>
      <div class="mx-auto w-16 h-16 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mb-4">
        <svg
          class="w-8 h-8 text-green-600 dark:text-green-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"
          />
        </svg>
      </div>
      Device Authorized Successfully
      <:subtitle>
        You can now close this window and return to your device.
      </:subtitle>
    </.header>
  </div>

  <div class="mt-8 text-center">
    <.link navigate={~p"/"} class="text-brand hover:underline">
      Return to home
    </.link>
  </div>
</div>
