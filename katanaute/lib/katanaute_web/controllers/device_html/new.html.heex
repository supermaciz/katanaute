<div class="mx-auto max-w-sm">
  <div class="text-center">
    <.header>
      Device Authorization
      <:subtitle>
        Enter the code shown on your device to authorize it.
      </:subtitle>
    </.header>
  </div>

  <.form :let={f} for={%{}} as={:device} action={~p"/admin/device"} method="post">
    <%= if @error do %>
      <div class="rounded-md bg-red-50 p-4 mb-4">
        <p class="text-sm text-red-800"><%= @error %></p>
      </div>
    <% end %>

    <.input
      field={f[:user_code]}
      type="text"
      label="Device Code"
      placeholder="ABCD-1234"
      value={@user_code}
      required
    />

    <div class="mt-2">
      <.button phx-disable-with="Verifying..." class="w-full">
        Continue
      </.button>
    </div>
  </.form>
</div>
